{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "SintraPrime Capability Registry",
 "type": "object",
 "required": [
  "registry_generation_id",
  "schema_version",
  "capabilities",
  "aliases"
 ],
 "properties": {
  "registry_generation_id": {
   "type": "string"
  },
  "schema_version": {
   "type": "string"
  },
  "capabilities": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "capability_id",
     "side_effect_class",
     "approval_policy",
     "status"
    ],
    "properties": {
     "capability_id": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_]+(\\.[a-z_]+)*$"
     },
     "side_effect_class": {
      "enum": [
       "READ_ONLY",
       "LOCAL_REVERSIBLE",
       "EXTERNAL_REVERSIBLE",
       "EXTERNAL_CONSEQUENTIAL",
       "IRREVERSIBLE",
       "VARIES_FORBIDDEN_WRAPPER"
      ]
     },
     "approval_policy": {
      "enum": [
       "NEVER_REQUIRED",
       "TIERED",
       "ALWAYS_REQUIRED"
      ]
     },
     "status": {
      "enum": [
       "ACTIVE",
       "DORMANT",
       "DEPRECATED"
      ]
     }
    }
   }
  },
  "aliases": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "alias",
     "canonical_id"
    ]
   }
  }
 }
}