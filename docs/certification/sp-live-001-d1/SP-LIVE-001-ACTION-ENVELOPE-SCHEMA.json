{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sintraprime.example/schemas/sp-live-001-action-envelope-v1.json",
  "title": "SP-LIVE-001 approval-bound action envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mission_id", "principal_identity", "action", "capability",
    "destination", "parameters", "consequence_class", "action_hash", "approval",
    "idempotency_key", "evidence_requirements", "mission_authority_hash",
    "capability_certification", "created_at", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mission_id": {"type": "string", "format": "uuid"},
    "principal_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["principal_id", "session_id", "verification_record_hash"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "verification_record_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "operation_id", "method", "object_count"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "operation_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "object_count": {"const": 1}
      }
    },
    "capability": {"type": "string", "minLength": 1},
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "host", "resource"],
      "properties": {
        "scheme": {"const": "https"},
        "host": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "account_binding_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "parameters": {"type": "object"},
    "consequence_class": {"enum": ["E0", "E1", "E2", "E3"]},
    "mission_authority_hash": {"$ref": "#/$defs/sha256"},
    "capability_certification": {
      "type": "object", "additionalProperties": false,
      "required": ["certification_id", "exact_head", "contract_hash", "valid_at_execution"],
      "properties": {
        "certification_id": {"type": "string", "minLength": 1},
        "exact_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "contract_hash": {"$ref": "#/$defs/sha256"},
        "valid_at_execution": {"const": true}
      }
    },
    "action_hash": {"$ref": "#/$defs/sha256"},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": [
        "approval_hash", "principal_id", "session_id", "action_hash", "approved_at",
        "expires_at", "nonce", "transcript_hash", "spoken_proposal_hash", "displayed_proposal_hash"
      ],
      "properties": {
        "approval_hash": {"$ref": "#/$defs/sha256"},
        "principal_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "action_hash": {"$ref": "#/$defs/sha256"},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "minLength": 16},
        "transcript_hash": {"$ref": "#/$defs/sha256"},
        "spoken_proposal_hash": {"$ref": "#/$defs/sha256"},
        "displayed_proposal_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 16},
    "evidence_requirements": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": [
        "authority_decision", "principal_approval", "action_envelope", "provider_attempt",
        "provider_receipt", "independent_verification", "evidence_chain", "written_principal_brief",
        "spoken_principal_brief"
      ]}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
